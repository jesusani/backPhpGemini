# VeriFactu VTS Configuration Example

# Clave Secreta para firmas digitales
VTS_SECRET_KEY="tu_clave_secreta_aqui"

# URL Base del API (Backend)
API_BASE_URL="http://localhost:8001/index.php"

# Usuario Simulado para el Frontend
FRONTEND_USER_ID="frontend_admin_user"

# Ruta DB
DB_PATH="vts_ledger.sqlite"

# Datos del Emisor (Factura Electrónica)
ISSUER_NAME="Tu Empresa S.L."
ISSUER_NIT="BXXXXXXXX"
ISSUER_ADDRESS="Tu Dirección Fiscal"
ISSUER_EMAIL="facturacion@tuempresa.com"

HOST_NAME="http://localhost:8001"
DATABASE="facturas.db"
USER_NAME="username"
PASSWORD="password"


